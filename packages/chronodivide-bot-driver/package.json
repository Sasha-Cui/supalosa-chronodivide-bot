{
    "name": "@supalosa/chronodivide-bot-driver",
    "version": "0.6.8-beta.3",
    "description": "Driver for Chronodivide game agents. Allows visualising game state while running in headless mode. ",
    "license": "UNLICENSED",
    "author": "Supalosa",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p .",
        "start": "node . --es-module-specifier-resolution=node",
        "benchmark": "node dist/benchmark/headToHead.js --es-module-specifier-resolution=node",
        "benchmark:suite": "node dist/benchmark/regressionSuite.js --es-module-specifier-resolution=node",
        "train:params": "node dist/training/parameterTrainer.js --es-module-specifier-resolution=node",
        "research:generate-plan": "node dist/training/researchPlanGenerator.js --es-module-specifier-resolution=node",
        "research:reduce-stage": "node dist/training/researchStageReducer.js --es-module-specifier-resolution=node",
        "research:run-plan": "node dist/training/researchPlanRunner.js --es-module-specifier-resolution=node",
        "analyze:training": "node dist/training/analyzeTrainingResults.js --es-module-specifier-resolution=node",
        "test": "vitest"
    },
    "peerDependencies": {
        "@chronodivide/game-api": "^0.75.0"
    },
    "devDependencies": {
        "typescript": "^4.3.5",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@supalosa/chronodivide-bot": "file:../chronodivide-bot",
        "canvas": "^3.2.0",
        "fetch-blob": "3.2.0",
        "file-system-access": "1.0.4"
    }
}
