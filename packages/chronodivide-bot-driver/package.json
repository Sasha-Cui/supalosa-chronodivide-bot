{
    "name": "@supalosa/chronodivide-bot-driver",
    "version": "0.6.8-beta.3",
    "description": "Driver for Chronodivide game agents. Allows visualising game state while running in headless mode. ",
    "license": "UNLICENSED",
    "author": "Supalosa",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p .",
        "start": "node . --es-module-specifier-resolution=node",
        "benchmark": "node dist/benchmark/headToHead.js --es-module-specifier-resolution=node",
        "benchmark:suite": "node dist/benchmark/regressionSuite.js --es-module-specifier-resolution=node",
        "train:params": "node dist/training/parameterTrainer.js --es-module-specifier-resolution=node",
        "research:generate-championship-plan": "node dist/training/researchChampionshipPlanGenerator.js --es-module-specifier-resolution=node",
        "research:reduce-championship": "node dist/training/researchChampionshipReducer.js --es-module-specifier-resolution=node",
        "research:generate-development-v2-plan": "node dist/training/researchDevelopmentV2PlanGenerator.js --es-module-specifier-resolution=node",
        "research:gate-development-v2-technical": "node dist/training/researchDevelopmentV2TechnicalGate.js --es-module-specifier-resolution=node",
        "research:unblind-development-v2": "node dist/training/researchDevelopmentV2Unblinder.js --es-module-specifier-resolution=node",
        "research:generate-confirmatory-plan": "node dist/training/researchConfirmatoryPlanGenerator.js --es-module-specifier-resolution=node",
        "research:gate-confirmatory-technical": "node dist/training/researchConfirmatoryTechnicalGate.js --es-module-specifier-resolution=node",
        "research:unblind-confirmatory": "node dist/training/researchConfirmatoryUnblinder.js --es-module-specifier-resolution=node",
        "research:generate-mechanism-ablation-plan": "node dist/training/researchMechanismAblationPlanGenerator.js --es-module-specifier-resolution=node",
        "research:gate-mechanism-ablation-technical": "node dist/training/researchMechanismAblationTechnicalGate.js --es-module-specifier-resolution=node",
        "research:analyze-mechanism-ablation": "node dist/training/researchMechanismAblationAnalyzer.js --es-module-specifier-resolution=node",
        "research:generate-component-ablation-plan": "node dist/training/researchComponentAblationPlanGenerator.js --es-module-specifier-resolution=node",
        "research:gate-component-ablation-technical": "node dist/training/researchComponentAblationTechnicalGate.js --es-module-specifier-resolution=node",
        "research:analyze-component-ablation": "node dist/training/researchComponentAblationAnalyzer.js --es-module-specifier-resolution=node",
        "research:generate-development-plan": "node dist/training/researchDevelopmentPlanGenerator.js --es-module-specifier-resolution=node",
        "research:gate-development-technical": "node dist/training/researchDevelopmentTechnicalGate.js --es-module-specifier-resolution=node",
        "research:unblind-development": "node dist/training/researchDevelopmentUnblinder.js --es-module-specifier-resolution=node",
        "research:generate-plan": "node dist/training/researchPlanGenerator.js --es-module-specifier-resolution=node",
        "research:finalize-optimizer": "node dist/training/researchOptimizerFinalizer.js --es-module-specifier-resolution=node",
        "research:reduce-stage": "node dist/training/researchStageReducer.js --es-module-specifier-resolution=node",
        "research:run-plan": "node dist/training/researchPlanRunner.js --es-module-specifier-resolution=node",
        "research:v5-baseline-equivalence": "node dist/training/methodV5BaselineEquivalence.js --es-module-specifier-resolution=node",
        "research:v5-all-country-smoke": "node dist/training/methodV5AllCountrySmoke.js --es-module-specifier-resolution=node",
        "research:v5-generate-campaign": "node dist/training/methodV5Campaign.js --es-module-specifier-resolution=node",
        "research:v5-run-plan": "node dist/training/methodV5PlanRunner.js --es-module-specifier-resolution=node",
        "research:v5-technical-gate": "node dist/training/methodV5TechnicalGate.js --es-module-specifier-resolution=node",
        "research:v5-analyze": "node dist/training/methodV5Analyzer.js --es-module-specifier-resolution=node",
        "analyze:training": "node dist/training/analyzeTrainingResults.js --es-module-specifier-resolution=node",
        "test": "vitest"
    },
    "peerDependencies": {
        "@chronodivide/game-api": "^0.75.0"
    },
    "devDependencies": {
        "typescript": "^4.3.5",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@supalosa/chronodivide-bot": "file:../chronodivide-bot",
        "canvas": "^3.2.0",
        "fetch-blob": "3.2.0",
        "file-system-access": "1.0.4"
    }
}
